          "cookies": [],
          "content": {
            "size": 35021,
            "mimeType": "text/javascript",
            "text": "import aiImage from \"/assets/ai.webp?import\";\nimport coldstackImage from \"/assets/coldstack.webp?import\";\nimport madhubaniImage from \"/assets/madhubani.webp?import\";\nimport postureImage from \"/assets/posture.webp?import\";\nimport qrImage from \"/assets/qr.webp?import\";\nimport rizzlerImage from \"/assets/rizzler.webp?import\";\nimport tarnishedtimesImage from \"/assets/tarnishedtimes.webp?import\";\nexport const projects = [\n  {\n    id: \"project-1\",\n    title: \"Artistically Intelligent\",\n    subtitle: \"AI visuals with human taste.\",\n    category: \"AI VISUAL STUDIO\",\n    description: \"Most AI-generated visuals look artificial because they prioritize generation over direction. Artistically Intelligent was created to explore a different philosophy: using AI as a creative collaborator while preserving human taste, composition, and brand identity.\",\n    details: \"Brands wanted AI-generated content, but they didn't want AI-looking content. Artistically Intelligent builds a visual system where every generated asset follows editorial art direction instead of random prompting. The website reflects the same philosophy—minimal, high-contrast, and image-first.\",\n    image: aiImage,\n    year: \"2026\",\n    role: \"Founder & Creative Lead\",\n    tags: [\"AI Art Direction\", \"Editorial Design\", \"Brand Identity\", \"Web Design\"],\n    challenge: \"Brands wanted AI-generated content. They didn't want AI-looking content.\",\n    approach: \"Develop a visual system where every generated asset follows editorial art direction instead of random prompting. The website reflects the same philosophy—minimal, high-contrast, and image-first.\",\n    creativeTech: [\"Midjourney\", \"Photoshop\", \"Figma\"],\n    devTech: [\"React\", \"GSAP\", \"Vite\"],\n    deploymentTech: [\"Vercel\"],\n    metricsFocus: \"Luxury Branding\",\n    metricsDeliverables: [\"Website\", \"AI Campaigns\", \"Identity System\"],\n    metricsStatus: \"Live\",\n    lesson: \"AI doesn't replace creative direction.\",\n    lessonDetail: \"AI can generate images, but it can't define taste. The role of a creative director isn't disappearing—it's becoming more important. It raises the standard for it.\",\n    colors: [\"#000000\", \"#FFFFFF\", \"#E5E5E5\", \"#EF4444\"],\n    fonts: [\"Outfit\", \"Playfair Display\", \"Inter\"],\n    link: \"https://artisticallyintelligent.in/\"\n  },\n  {\n    id: \"project-2\",\n    title: \"Tarnished Times\",\n    subtitle: \"A digital archive of forgotten narratives.\",\n    category: \"DIGITAL PUBLICATION\",\n    description: \"An editorial exploration of history, decay, and time. Tarnished Times compiles stories of abandoned architectural structures, obsolete machinery, and forgotten artifacts, presenting them through a highly cinematic digital journal.\",\n    details: \"Tarnished Times bridges the gap between physical memory and digital preservation, capturing the tactile feel of aged paper, ink, and dust in a clean, modern digital reader. It uses high-contrast typography, grain overlays, and custom page-turn physics to evoke nostalgia while maintaining accessibility.\",\n    image: tarnishedtimesImage,\n    year: \"2025\",\n    role: \"Editor-in-Chief & Web Designer\",\n    tags: [\"Editorial Layout\", \"Digital Publishing\", \"Photography\", \"Typography\"],\n    challenge: \"Capturing the tactile feel of aged paper, ink, and dust in a clean, modern digital reader.\",\n    approach: \"Utilizing high-contrast typography, grain overlays, and custom page-turn physics to evoke nostalgia while maintaining accessibility.\",\n    creativeTech: [\"Lightroom\", \"Figma\", \"InDesign\"],\n    devTech: [\"Next.js\", \"TailwindCSS\", \"Framer Motion\"],\n    deploymentTech: [\"Vercel\"],\n    metricsFocus: \"Cultural Archiving\",\n    metricsDeliverables: [\"Digital Journal\", \"Print Annual\", \"Custom Reader\"],\n    metricsStatus: \"Active\",\n    lesson: \"Aesthetics are the bridge to history.\",\n    lessonDetail: \"Digital design doesn't have to be sterile. By bringing texture, grain, and physical physics online, we create emotional connections to content.\",\n    colors: [\"#2B261F\", \"#F4EDE2\", \"#8C7E6C\", \"#C2A67E\"],\n    fonts: [\"Cinzel Decorative\", \"EB Garamond\", \"Lora\"],\n    link: \"https://tarnishedpixels.netlify.app/\"\n  },\n  {\n    id: \"project-3\",\n    title: \"Rizzler\",\n    subtitle: \"Choreographing dynamic digital interactions.\",\n    category: \"INTERACTIVE APPLICATION\",\n    description: \"Rizzler is a playful, high-energy interactive experience designed to explore the boundaries of modern CSS physics, sound integration, and responsive typography.\",\n    details: \"Making interactions feel physical, bouncy, and alive without compromising performance. Rizzler is built on a minimal canvas with spring physics, custom sound design, and micro-interactions that respond to mouse velocity.\",\n    image: rizzlerImage,\n    year: \"2025\",\n    role: \"Lead Designer & Creative Developer\",\n    tags: [\"Interaction Choreography\", \"Web Audio API\", \"Micro-animations\"],\n    challenge: \"Making interactions feel physical, bouncy, and alive without compromising performance.\",\n    approach: \"A minimal canvas with spring physics, custom sound design, and micro-interactions that respond to mouse velocity.\",\n    creativeTech: [\"Figma\", \"Ableton Live\"],\n    devTech: [\"React\", \"Web Audio API\", \"GSAP\"],\n    deploymentTech: [\"Netlify\"],\n    metricsFocus: \"User Engagement\",\n    metricsDeliverables: [\"Web Application\", \"Audio System\", \"Motion Guidelines\"],\n    metricsStatus: \"Live\",\n    lesson: \"Play is the ultimate form of utility.\",\n    lessonDetail: \"Adding personality and physical feedback to simple actions increases retention and turns everyday interactions into memorable events.\",\n    colors: [\"#0F172A\", \"#38BDF8\", \"#EC4899\", \"#F8FAFC\"],\n    fonts: [\"Clash Display\", \"Satoshi\", \"Inter\"],\n    link: \"https://rizzgod-nu.vercel.app/\"\n  },\n  {\n    id: \"project-4\",\n    title: \"QR Codes Redefined\",\n    subtitle: \"Functional art in everyday touchpoints.\",\n    category: \"IDENTITY SYSTEM\",\n    description: \"An exploration in transforming ugly QR codes into brand-aligned art. By blending custom patterns, color gradients, and structural framing, utility becomes a beautiful extension of brand identity.\",\n    details: \"Customizing QR code matrix data without breaking scannability or contrast rules. We developed a custom styling engine that maintains the error correction blocks while modifying pixel patterns to align with branding.\",\n    image: qrImage,\n    year: \"2026\",\n    role: \"Product Designer & Software Engineer\",\n    tags: [\"Branding\", \"Generative Systems\", \"Canvas API\", \"Utility Design\"],\n    challenge: \"Customizing QR code matrix data without breaking scannability or contrast rules.\",\n    approach: \"Writing a custom styling engine that maintains the error correction blocks while modifying pixel patterns.\",\n    creativeTech: [\"Illustrator\", \"Figma\"],\n    devTech: [\"TypeScript\", \"Canvas API\", \"Vite\"],\n    deploymentTech: [\"AWS\"],\n    metricsFocus: \"Utility Branding\",\n    metricsDeliverables: [\"Generator Engine\", \"Vector Branding\", \"API Service\"],\n    metricsStatus: \"Live\",\n    lesson: \"No detail is too small for design.\",\n    lessonDetail: \"Even the most boring utility can become a brand asset if you treat it with the same respect as a logo or a billboard.\",\n    colors: [\"#18181B\", \"#22C55E\", \"#A1A1AA\", \"#F4F4F5\"],\n    fonts: [\"Space Mono\", \"JetBrains Mono\", \"Geist\"],\n    link: \"https://trace-khaki.vercel.app/\"\n  },\n  {\n    id: \"project-5\",\n    title: \"Posture Monitor\",\n    subtitle: \"Real-time physical feedback via computer vision.\",\n    category: \"AI APPLICATION\",\n    description: \"Posture Monitor utilizes real-time client-side computer vision to track body alignment and gently nudge users to maintain healthy posture during long screen sessions.\",\n    details: \"Running body tracking models in the browser without lagging the user's primary workspace. Posture Monitor leverages lightweight TensorFlow.js models, CSS custom properties for responsive feedback, and local storage for privacy.\",\n    image: postureImage,\n    year: \"2025\",\n    role: \"Founder & AI Engineer\",\n    tags: [\"Computer Vision\", \"TensorFlow.js\", \"Client-side AI\", \"UI/UX\"],\n    challenge: \"Running body tracking models in the browser without lagging the user's primary workspace.\",\n    approach: \"Leveraging lightweight TensorFlow.js models, CSS custom properties for responsive feedback, and local storage for privacy.\",\n    creativeTech: [\"Figma\"],\n    devTech: [\"React\", \"TensorFlow.js\", \"TailwindCSS\"],\n    deploymentTech: [\"Vercel\"],\n    metricsFocus: \"Health Tech\",\n    metricsDeliverables: [\"Web App\", \"AI Model Integration\", \"Analytics Dashboard\"],\n    metricsStatus: \"Active\",\n    lesson: \"Technology should serve human health.\",\n    lessonDetail: \"AI doesn't always need massive GPU servers. Local, client-side intelligence is faster, preserves privacy, and integrates seamlessly into user lives.\",\n    colors: [\"#052E16\", \"#22C55E\", \"#EF4444\", \"#F0FDF4\"],\n    fonts: [\"Plus Jakarta Sans\", \"Inter\", \"Outfit\"],\n    link: \"https://posturewebsite.vercel.app/\"\n  },\n  {\n    id: \"project-6\",\n    title: \"Madhubani Fusion\",\n    subtitle: \"Digitizing ancestral folk art techniques.\",\n    category: \"ART ARCHIVE\",\n    description: \"A digital preservation and contemporary fusion project highlighting Madhubani painting—a traditional Indian art form characterized by geometric patterns and vibrant natural pigments.\",\n    details: \"Translating the hand-painted, organic brushstrokes of folk artists into vector graphics without losing their soul. The project combines high-resolution scanning, manual vector trace mapping, and a generative layout engine.\",\n    image: madhubaniImage,\n    year: \"2026\",\n    role: \"Creative Director & Digital Artisan\",\n    tags: [\"Cultural Preservation\", \"Generative Art\", \"Hand Illustration\", \"SVG Filters\"],\n    challenge: \"Translating the hand-painted, organic brushstrokes of folk artists into vector graphics without losing their soul.\",\n    approach: \"High-resolution scanning, manual vector trace mapping, and a generative layout engine that constructs traditional borders dynamically.\",\n    creativeTech: [\"Hand Illustration\", \"Photoshop\", \"Figma\"],\n    devTech: [\"HTML5 Canvas\", \"React\", \"SVG Filters\"],\n    deploymentTech: [\"GitHub Pages\"],\n    metricsFocus: \"Cultural Heritage\",\n    metricsDeliverables: [\"Digital Collection\", \"Generative Art Engine\", \"Print Lookbook\"],\n    metricsStatus: \"Archive\",\n    lesson: \"Heritage is the foundation of innovation.\",\n    lessonDetail: \"Modern design systems can learn from ancient folk art. The rules of geometry, contrast, and storytelling are universal across centuries.\",\n    colors: [\"#450A0A\", \"#FACC15\", \"#EA580C\", \"#FEFCE8\"],\n    fonts: [\"Rozha One\", \"Lora\", \"EB Garamond\"],\n    link: \"https://madhubanii.netlify.app/\"\n  },\n  {\n    id: \"project-7\",\n    title: \"ColdStack\",\n    subtitle: \"Sleek analytics for decentralized storage.\",\n    category: \"INFRASTRUCTURE & DASHBOARD\",\n    description: \"ColdStack is a beautiful, performance-driven web interface and analytics dashboard designed to monitor and optimize decentralized file storage networks.\",\n    details: \"Displaying massive real-time storage metrics and node statuses in a clean, visual format. The interface leverages custom data visualization, WebSockets integration, and a highly optimized grid layout for multi-node tracking.\",\n    image: coldstackImage,\n    year: \"2025\",\n    role: \"Lead UI Designer & Frontend Engineer\",\n    tags: [\"Dashboard Design\", \"Data Visualization\", \"Decentralized Web\", \"WebSockets\"],\n    challenge: \"Displaying massive real-time storage metrics and node statuses in a clean, visual format.\",\n    approach: \"Custom data visualization, WebSockets integration, and a highly optimized grid layout for multi-node tracking.\",\n    creativeTech: [\"Figma\", \"Illustrator\"],\n    devTech: [\"React\", \"Chart.js\", \"TailwindCSS\"],\n    deploymentTech: [\"Vercel\"],\n    metricsFocus: \"Developer Tooling\",\n    metricsDeliverables: [\"Analytics Dashboard\", \"Style Guide\", \"Interface Library\"],\n    metricsStatus: \"Live\",\n    lesson: \"Complex data deserves clean layout.\",\n    lessonDetail: \"Developers prefer beautiful dashboards. Making data legible and responsive reduces cognitive load and makes system monitoring satisfying.\",\n    colors: [\"#09090B\", \"#3B82F6\", \"#10B981\", \"#FAFAFA\"],\n    fonts: [\"Geist\", \"Geist Mono\", \"Inter\"],\n    link: \"https://coldstack.onrender.com/\"\n  }\n];\n\n//# sourceMappingURL=data:application/json;base64,"
          },
